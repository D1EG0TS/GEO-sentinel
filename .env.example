# Sentinel-Geo - Microservicio de Geolocalización y Auditoría
# Configuración de entorno

# Token de IPinfo.io (nivel gratuito - 50k requests/mes)
# Obtén tu token gratis en: https://ipinfo.io/signup
IPINFO_TOKEN=tu_token_aqui

# Puerto del servicio
PORT=8080

# Orígenes permitidos para CORS
# Para desarrollo: *
# Para producción: https://tudominio.com,https://app.tudominio.com
CORS_ORIGINS=*

# Clave API para endpoints protegidos
API_KEY_SECRET=tu_clave_secreta_aqui
